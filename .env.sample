# Conexão com Banco de Dados PostgreSQL (Neon Serverless)
# Obtenha sua connection string em: https://neon.tech
DATABASE_URL="postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/vicentinos_db?sslmode=require"

# Criptografia do Better-Auth (mínimo 32 caracteres aleatórios)
BETTER_AUTH_SECRET="gere-uma-chave-secreta-de-minimo-32-caracteres-aqui"
BETTER_AUTH_URL="http://localhost:3002"

# Porta de execução do Next.js
PORT="3002"
HOSTNAME="0.0.0.0"
NODE_ENV="development"
